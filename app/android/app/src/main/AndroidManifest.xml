<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Sync only. The app is fully usable with this denied or offline. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Android 13+ gates notifications behind a runtime grant. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- ⚠ Exact alarms are load-bearing: every reminder in this app has a date
         known at creation time, and an inexact alarm may slide by hours.
         SCHEDULE_EXACT_ALARM is the requestable one (see Notifier._checkReady).
         USE_EXACT_ALARM is auto-granted for apps whose core function is
         reminders, which this is — but it is Play Store restricted, so if this
         ever goes near Play rather than a sideload, drop it and rely on the
         runtime request. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>

    <!-- Pending alarms do not survive a reboot on their own. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <application
        android:label="personal_crm"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- ⛔ THESE RECEIVERS ARE LOAD-BEARING AND THE PLUGIN DOES NOT SUPPLY
             THEM. flutter_local_notifications' own manifest declares only
             permissions, so without these the alarm fires, AlarmManager counts
             the wakeup, and the broadcast lands on nothing. No notification, no
             error, no log — the exact silent failure this app is built to
             avoid, since an armed-but-dead schedule is indistinguishable from a
             quiet month.

             Observed before the fix: 18 alarms scheduled, "18 wakes 18 alarms"
             in dumpsys, zero notifications posted and no channel ever created.

             ScheduledNotificationBootReceiver re-arms pending alarms after a
             reboot, which the 11 Sep canary exists to test. -->
        <receiver android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- ⚠ Without this, url_launcher cannot see a browser or WhatsApp and
             the wa.me link silently fails to open — which is the core
             interaction of the core loop. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
